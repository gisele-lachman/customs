# Copy this file to .env and fill in your own value. Never commit .env.
# The app looks for .env in this folder first, then in the folder above it.

# Required: your Portkey API key (placeholder below; use your own)
PORTKEY_API_KEY=your-portkey-api-key-here

# Everything below is optional. Uncomment a line only to change the default shown.

# Checker: on by default; set to off to measure without it
# CUSTOMS_CHECKER=off

# Test switch, off by default: on puts a random line at the start of every model call so nothing is cached
# CUSTOMS_DEFEAT_CACHE=on

# Budget guard and limits (defaults live in app/config.py)
# CUSTOMS_DAILY_BUDGET_USD=2.00
# CUSTOMS_RUNS_PER_HOUR_PER_VISITOR=15
# CUSTOMS_MAX_SITUATION_CHARS=500
# CUSTOMS_MAX_TOOL_CALLS=8
# CUSTOMS_MAX_MODEL_REQUESTS=10
